{
  "experiment": {
    "id": "A_flow_matching",
    "loss": "flow_matching",
    "lambda_fm": 0.0,
    "decoder_finetune": false,
    "corruption": "flow",
    "clamp_recon": false,
    "best_metric": "fm"
  },
  "rae_config": "configs/stage2/training/ImageNet256/DiTDH-XL_DINOv2-B.yaml",
  "rae_config_overrides": {
    "stage_2": {
      "ckpt": "models/DiTs/Dinov2/wReg_base/ImageNet256/DiTDH-XL/stage2_model.pt"
    }
  },
  "noise": {
    "time_dist": "logit-normal_0_1",
    "warp": false
  },
  "size": 256,
  "seed": 2,
  "scope": "per_category",
  "training": {
    "steps": 4000,
    "batch_size": 2,
    "grad_accum_steps": 4,
    "precision": "fp32",
    "clip_grad": 1.0,
    "log_every": 50,
    "val_every": 250,
    "save_every": 500,
    "n_val": 20,
    "use_ema": true,
    "ema_decay": 0.9995,
    "grad_checkpoint": false,
    "ema_device": "cuda",
    "cache_latents": true,
    "decoder_lr_ratio": 0.1,
    "optimizer": {
      "lr": 0.0002,
      "betas": [
        0.9,
        0.95
      ],
      "weight_decay": 0.0,
      "eps": 1e-08
    },
    "scheduler": {
      "type": "linear",
      "base_lr": 0.0002,
      "final_lr": 2e-05,
      "warmup_steps": 400,
      "decay_end_steps": 4000,
      "warmup_from_zero": false
    }
  },
  "inference": {
    "mode": "single",
    "t": 0.5,
    "reps": 1,
    "ode_steps": 50,
    "blur_sigma": 4.0
  }
}