{
  "experiment": {
    "id": "ab_noise_sigma005",
    "loss": "image_l1",
    "lambda_fm": 0.0,
    "decoder_finetune": false,
    "corruption": "simplenet",
    "clamp_recon": false,
    "best_metric": "img"
  },
  "discriminator": {
    "enabled": true,
    "d": 256,
    "blocks": 4,
    "w_seg": 1.0,
    "gamma": 2.0,
    "detach": true
  },
  "rae_config": "configs/stage2/training/ImageNet256/DiTDH-XL_DINOv2-B.yaml",
  "rae_config_overrides": {
    "stage_2": {
      "ckpt": "models/DiTs/Dinov2/wReg_base/ImageNet256/DiTDH-XL/stage2_model.pt"
    }
  },
  "noise": {
    "sigma": 0.05,
    "mask": "perlin",
    "p_clean": 0.2,
    "w_anom": 5.0,
    "mask_thr": 0.5
  },
  "size": 256,
  "seed": 0,
  "scope": "joint",
  "training": {
    "steps": 4000,
    "batch_size": 2,
    "grad_accum_steps": 4,
    "precision": "fp32",
    "sdpa": "math",
    "clip_grad": 1.0,
    "log_every": 50,
    "val_every": 250,
    "save_every": 500,
    "n_val": 20,
    "use_ema": true,
    "ema_decay": 0.9995,
    "grad_checkpoint": false,
    "ema_device": "cuda",
    "cache_latents": true,
    "decoder_lr_ratio": 0.1,
    "optimizer": {
      "lr": 0.0002,
      "betas": [
        0.9,
        0.95
      ],
      "weight_decay": 0.0,
      "eps": 1e-08
    },
    "scheduler": {
      "type": "linear",
      "base_lr": 0.0002,
      "final_lr": 2e-05,
      "warmup_steps": 400,
      "decay_end_steps": 4000,
      "warmup_from_zero": false
    }
  },
  "inference": {
    "mode": "single",
    "t": 0.05,
    "reps": 1,
    "ode_steps": 50,
    "blur_sigma": 4.0
  }
}